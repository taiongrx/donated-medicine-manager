# =====================================================================
# secrets.toml.example — Configuration Template
# คัดลอกไฟล์นี้เป็น secrets.toml (ห้าม commit secrets.toml จริงขึ้น Git)
# =====================================================================

[database]
host = "YOUR_HOSXP_HOST"
port = 3306
name = "hos"
user = "YOUR_HOSXP_USER"
password = "YOUR_HOSXP_PASSWORD"
driver = "mysql+pymysql"
# url = "mysql+pymysql://YOUR_HOSXP_USER:YOUR_HOSXP_PASSWORD@YOUR_HOSXP_HOST:3306/hos"

[system]
hospital_name = "โรงพยาบาลสมเด็จพระยุพราชสายบุรี"
hospital_code = "10690"
environment = "production"
