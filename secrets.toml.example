# =====================================================================
# secrets.toml.example — Configuration Template
# คัดลอกไฟล์นี้เป็น secrets.toml (ห้าม commit secrets.toml จริงเข้า git)
# =====================================================================

[database]
host = "192.168.0.251"
port = 3306
name = "hos"
user = "sa"
password = "YOUR_HOSXP_PASSWORD"
driver = "mysql+pymysql"
url = "mysql+pymysql://sa:YOUR_HOSXP_PASSWORD@192.168.0.251:3306/hos"

[system]
hospital_name = "โรงพยาบาลสมเด็จพระยุพราชสายบุรี"
hospital_code = "10690"
environment = "production"
