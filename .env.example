# =====================================================================
# Donated Medicine Manager - Configuration Environment
# โรงพยาบาลสมเด็จพระยุพราชสายบุรี
# =====================================================================

# 1. การตั้งค่าการเชื่อมต่อฐานข้อมูล HOSxP (SQLAlchemy Database URL)
# สลับไปรัน MySQL/MariaDB หลักของ รพ. ได้โดยระบุ Connection string ในรูปแบบนี้
#
# รูปแบบ MySQL: mysql+pymysql://[user]:[password]@[host]:[port]/[database_name]
# ตัวอย่าง:
DATABASE_URL=mysql+pymysql://hosxp_user:hosxp_password@192.168.1.100:3306/hosxp_db

# หากต้องการรันข้อมูลจำลองในเครื่องต่อโดยใช้ SQLite ให้ปล่อยว่างไว้ หรือใส่ค่าดังนี้
# DATABASE_URL=sqlite:////app/donated_medicine.db
