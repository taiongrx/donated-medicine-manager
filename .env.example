# =====================================================================
# Donated Medicine Manager - Configuration Environment
# โรงพยาบาลสมเด็จพระยุพราชสายบุรี
# =====================================================================
# คัดลอกไฟล์นี้เป็น .env หรือใช้ secrets.toml (ห้าม commit ไฟล์จริงขึ้น Git)

# 1. การตั้งค่าการเชื่อมต่อฐานข้อมูล HOSxP (MySQL/MariaDB จริงเท่านั้น - Zero Mockup Policy)
# รูปแบบ: mysql+pymysql://[user]:[password]@[host]:[port]/[database_name]
DATABASE_URL=mysql+pymysql://YOUR_HOSXP_USER:YOUR_HOSXP_PASSWORD@YOUR_HOSXP_HOST:3306/hos

# หรือระบุแยกตามตัวแปร (หากไม่ได้ตั้ง DATABASE_URL)
# DB_HOST=YOUR_HOSXP_HOST
# DB_PORT=3306
# DB_USER=YOUR_HOSXP_USER
# DB_PASSWORD=YOUR_HOSXP_PASSWORD
# DB_NAME=hos

# 2. การตั้งค่า Sub-App สำหรับเชื่อมต่อใต้ MEDUSA AI+
# ปล่อยว่างเมื่อรันแบบ Standalone ที่ root (/) หรือระบุเช่น /donated-medicine เมื่อ proxy ไม่ได้ strip prefix
APP_BASE_PATH=
ROOT_PATH=
HOST=0.0.0.0
PORT=8000
